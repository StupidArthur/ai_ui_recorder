{
  "name": "trace",
  "version": "0.96.0",
  "description": "Evidence-driven UI interaction recorder",
  "main": "index.js",
  "scripts": {
    "dashboard": "node src/dashboard",
    "record": "node src/recorder",
    "record:electron": "node src/recorder/electron-cli.js",
    "build:electron-recorder": "powershell -ExecutionPolicy Bypass -File scripts/build-electron-recorder.ps1",
    "app": "node src/app",
    "build:bundle": "node build/esbuild.config.mjs",
    "build:trial": "powershell -ExecutionPolicy Bypass -File scripts/build-trial.ps1",
    "test": "node --check src/app/index.js && node --check src/dashboard/index.js && node --check src/dashboard/server.js && node --check src/recorder/index.js && node --check src/recorder/recorder.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@playwright/test": "^1.49.1",
    "chrome": "^0.1.0",
    "chromium-bidi": "^0.6.0",
    "playwright-core": "^1.49.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "pkg": "^5.8.1"
  }
}
